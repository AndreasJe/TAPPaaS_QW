# QualiWare secrets file template
#
# Copy this file to the tappaas-cicd VM as:
#   /home/tappaas/secrets/qualiware.env
#
# Set permissions so only tappaas can read it:
#   chmod 600 /home/tappaas/secrets/qualiware.env
#
# This file is sourced by install-service.sh and install-qualiware.sh at install/upgrade time.
# It is NOT tracked in git — manage it manually on the server.

SQL_PASSWORD=CHANGE_ME_BEFORE_INSTALL

# QualiWare admin account — used by the unattended installer.
# If you have changed the default password on a running system, update this before upgrading.
QEF_ADMIN_USER=Admin
QEF_ADMIN_PASSWORD=CHANGE_ME_BEFORE_INSTALL
